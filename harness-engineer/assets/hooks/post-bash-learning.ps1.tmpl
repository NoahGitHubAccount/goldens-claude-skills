<#
.SYNOPSIS
  PostToolUse hook — Bash 失敗時把指令與 stderr 摘要寫入 learnings/inbox.md。

.DESCRIPTION
  Hook 從 stdin 收到 JSON，含 tool_input.command 與 tool_response.exit_code/stderr。
  僅在 exit_code != 0 時觸發，避免噪音。

  **寫入收件匣而不是直接建卡**：自動蒐集的失敗訊息多數只是一時的輸入錯誤，
  直接建成卡片會讓 learnings/cards/ 充滿雜訊。收件匣是給人過濾用的暫存區，
  確認某則值得留存後，再用 new-learning-card.ps1 建成正式卡片。

.NOTES
  複製到 <project>/.claude/hooks/post-bash-learning.ps1。
  寫入位置：<project>/learnings/inbox.md

  建議把 learnings/inbox.md 加入 .gitignore —— 那是個人的待整理暫存，
  不需要進版控，也就不會與同事衝突。
#>

$input | Out-String | Set-Variable -Name raw
try {
    $payload = $raw | ConvertFrom-Json
} catch {
    exit 0
}

$exitCode = $payload.tool_response.exit_code
if (-not $exitCode -or $exitCode -eq 0) { exit 0 }

$projectDir = $env:CLAUDE_PROJECT_DIR
if (-not $projectDir) { exit 0 }

$learningsDir = Join-Path $projectDir 'learnings'
if (-not (Test-Path -LiteralPath $learningsDir)) { exit 0 }

$inboxFile = Join-Path $learningsDir 'inbox.md'

$cmd = $payload.tool_input.command
if (-not $cmd) { exit 0 }
$cmdShort = if ($cmd.Length -gt 200) { $cmd.Substring(0, 200) + '...' } else { $cmd }

$stderr = $payload.tool_response.stderr
if (-not $stderr) { $stderr = '(無 stderr)' }
$stderrShort = if ($stderr.Length -gt 300) { $stderr.Substring(0, 300) + '...' } else { $stderr }

$stamp = Get-Date -Format 'yyyy-MM-dd HH:mm'

# 收件匣不存在就先寫入說明，讓看到檔案的人知道該怎麼處理
if (-not (Test-Path -LiteralPath $inboxFile)) {
    $header = @"
# 待整理（Hook 自動寫入）

> 這裡是 Bash 失敗時自動蒐集的原始訊息，**不是正式的經驗卡**。
>
> 處理方式：
> 1. 看過一遍，多數只是一時的輸入錯誤，直接刪掉即可
> 2. 確實值得留存的，執行 new-learning-card.ps1 建成正式卡片
> 3. 建卡後把這裡對應的段落刪除
>
> 本檔建議加入 .gitignore：它是個人暫存，不需要進版控。

"@
    [System.IO.File]::WriteAllText($inboxFile, $header, (New-Object System.Text.UTF8Encoding $false))
}

$entry = @"

## [$stamp] Bash 失敗（exit $exitCode）

- 指令：``$cmdShort``
- stderr：$stderrShort
"@

Add-Content -LiteralPath $inboxFile -Value $entry -Encoding UTF8

exit 0
